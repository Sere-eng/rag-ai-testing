# Copy this file to .env and fill in your keys
# cp .env.example .env

# Required: OpenRouter API key (get one at https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required for embeddings (when using OpenAI backend):
# standard OpenAI API key (https://platform.openai.com/)
# If you want to use OpenRouter for embeddings too, you can set this to your OpenRouter key
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings backend:
#   - openai      → uses OpenAIEmbeddings (text-embedding-3-small by default)
#   - huggingface → uses HuggingFaceEmbeddings (BAAI/bge-small-en-v1.5 by default)
EMBEDDING_PROVIDER=huggingface

# Optional overrides for embedding models
#OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small
#HF_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional: Hugging Face token (for private models / higher limits)
#HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# Optional: LangSmith tracing (https://smith.langchain.com/)
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
